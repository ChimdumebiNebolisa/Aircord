# Local demo defaults to deterministic fixtures and a SQLite memory store.
AIRCORD_MODE=fixture
AIRCORD_DATA_DIR=./data
AIRCORD_DB_PATH=./data/aircord.sqlite3

# CockroachDB Cloud connection for smoke tests and deployed persistence.
# Replace the password placeholder; never commit a real .env file.
DATABASE_URL=postgresql://chimdumebi:REPLACE_WITH_PASSWORD@aircord-30966.j77.aws-us-east-1.cockroachlabs.cloud:26257/aircord?sslmode=verify-full&sslrootcert=system
# Download the cluster CA certificate from CockroachDB Cloud's Connect dialog.
# Set this to the local path when the system trust store does not contain it.
DATABASE_CA_CERT=

# Optional live ingestion credentials. Never commit real values.
AIRNOW_API_KEY=
PURPLEAIR_API_KEY=
AIRCORD_BEDROCK_MODEL_ID=

# Frontend can point at another API during development.
VITE_API_BASE=http://localhost:8000

